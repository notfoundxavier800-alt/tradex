# ==============================================================================
# TRADEX + TRADINGAGENTS + AI HEDGE FUND CONSOLIDATED ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRADEX SERVER & ENGINE
# ------------------------------------------------------------------------------
TRADEX_PORT=5000
TRADEX_HOST=0.0.0.0
TRADEX_SECRET_KEY=cwallet-signal-bot-secret
TRADEX_DEFAULT_MARKET=crypto   # "crypto", "indian", "international"
TRADEX_DEFAULT_SYMBOL=btcusdt
TRADEX_ZERO_DEFECT_MODE=false
TRADEX_CRYPTO_PRICE_SOURCE=auto # "auto", "futures", "spot"

# ------------------------------------------------------------------------------
# 2. LLM PROVIDERS FOR MULTI-AGENT DEBATE & INVESTOR PERSONAS
# Set at least one provider key to activate AI agent analysis.
# ------------------------------------------------------------------------------
# Google Gemini (Recommended for speed & generous context)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3)
OPENAI_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3.7)
ANTHROPIC_API_KEY=

# DeepSeek (DeepSeek V3, DeepSeek R1)
DEEPSEEK_API_KEY=

# Groq (Ultra-fast Llama-3.3-70B inference)
GROQ_API_KEY=

# xAI (Grok-2)
XAI_API_KEY=

# Local Ollama server (e.g. http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 3. FINANCIAL DATA FEEDS & MACRO APIS (Optional)
# ------------------------------------------------------------------------------
# Financial Datasets (for AI Hedge Fund balance sheets, earnings, filings)
FINANCIAL_DATASETS_API_KEY=

# FRED API (Federal Reserve Economic Data)
# FRED_API_KEY=

# SEC EDGAR user agent (e.g. YourName your@email.com)
# SEC_EDGAR_USER_AGENT=TradeXUser trader@tradex.local

# ------------------------------------------------------------------------------
# 4. TRADINGAGENTS CONFIGURATION OVERRIDES
# ------------------------------------------------------------------------------
TRADINGAGENTS_LLM_PROVIDER=google
TRADINGAGENTS_DEEP_THINK_LLM=gemini-2.0-flash
TRADINGAGENTS_QUICK_THINK_LLM=gemini-2.0-flash
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_TEMPERATURE=0.1
